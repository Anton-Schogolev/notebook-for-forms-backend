ADMIN_USERNAME="admin"
ADMIN_PASSWORD="root"

ORIGINS='["*"]'

# openssl rand -hex 32
SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local PostgreSQL. Keep these credentials in sync with DATABASE_URL.
POSTGRES_DB=notebook
POSTGRES_USER=notebook
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql+psycopg://notebook:replace-with-local-password@localhost:5432/notebook
